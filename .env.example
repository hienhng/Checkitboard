DATABASE_URL=postgresql://postgres:password@localhost:5432/checkit
SESSION_SECRET=replace-with-a-long-random-secret
PORT=5000

# Public HTTPS URL in production, e.g. https://checkit.vercel.app.
# Used by verification, welcome, and password-reset emails.
FRONTEND_URL=http://localhost:5000

# Email: configure Gmail OR all SMTP settings below.
EMAIL_USER=
EMAIL_APP_PASSWORD=
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false

# Google AI Studio API key (server only)
GEMINI_API_KEY=
# Optional model override
GEMINI_MODEL=gemini-2.5-flash

# Optional alternative AI providers
OPENAI_API_KEY=
HUGGINGFACE_API_KEY=
